  "skipped": [
    {
      "id": "crumble-delia-643",
      "why": "Rests entirely on an AI-generated SEO farm cluster. Never verified against Delia. Was cited as a headline finding in an early pass — that was the single weakest citation in the survey."
    },
    {
      "id": "crisp-serious-eats-oatfree",
      "why": "NO OATS AT ALL — excluded from the oat-bearing medians, but recorded because it is the most important counterexample in the project."
    },
    {
      "id": "cobbler-foodtalk",
      "why": "PROBABLY AI-GENERATED OR CONTENT FARM. 2025 date, generic byline, SEO-shaped title, interchangeable frozen/fresh/canned ingredient line, and a formula that would barely cohere — 113.6 g butter against only 80 g milk on 187.5 g flour."
    },
    {
      "id": "crumble-nigella-jumbleberry",
      "why": "The recipe does not add up: as written the topping makes 187.5 g but the method directs 75 g across each of 4 ramekins = 300 g, a 60% shortfall. Every derived figure inherits that ambiguity, and the ramekin area is the weakest geometric inference in the survey."
    },
    {
      "id": "crumble-ottolenghi-cheesecake",
      "why": "NOT A FRUIT CRUMBLE — a cheesecake garnish, baked separately. It nevertheless supplied the single quantified salt figure used for the British core subset, giving a cheesecake topping disproportionate weight in the salt analysis."
    },
    {
      "id": "crumble-atk-crumb-pie",
      "why": "US crumb pie, not a British crumble. At butter 135.5 it is the extreme outlier that forced two separate medians, and it is simultaneously the LOWEST-RATED source in the survey (3.5 stars, 13 reviews) with no published gram weights."
    },
    {
      "id": "crumble-great-british-chefs",
      "why": "The topping is baked ALONE for 30-40 minutes as a granola, stirred every 10, then assembled for a 10-12 minute finish. Its 750 g is a batch yield, not an applied quantity, so its fruit:topping ratio is not comparable — yet it was included in that median anyway."
    },
    {
      "id": "crumble-delicious-magazine",
      "why": "TIER-3: the page returned 403 and was never fetched. It entered the published ratio table on search-summary evidence alone, unflagged, where it anchored the TOP of both the butter and sugar ranges (100/100). It is also a separately pre-baked crumble, not a conventional one."
    },
    {
      "id": "crisp-atk-905-oatfree",
      "why": "NO OATS — excluded from the oat-bearing medians, but it is ATK's own crisp and it states outright that the ideal crisp topping is nuts and flour. One of five canonical oat-free 'crisps'."
    },
    {
      "id": "crisp-chez-panisse-pear",
      "why": "NO OATS. Sugar at 17.5 per 100 flour is less than half the lowest oat-bearing crisp (Dorie, 36.4) — a strikingly lean, nut-driven topping from the restaurant most associated with the American fruit-dessert revival."
    },
    {
      "id": "cobbler-ka-individual-berry",
      "why": "Ramekin area (201 cm2) is the single most unreliable geometric inference in the survey and produces the 2.018 g/cm2 outlier that topped the load range. Excluding it moves the cobbler load median only from 0.846 to 0.845 but shrinks the range from 0.626-2.018 to 0.626-1.574."
    },
    {
      "id": "batter-magic-cobbler",
      "why": "Weakest source in the survey: folk canon, no named author, reconstructed from a search summary, no pan size. Recorded only to bound the batter-cobbler range."
    }
  ]
